{
  "name": "scx-laser-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:reset": "node scripts/clean-next.mjs && next dev",
    "clean:next": "node scripts/clean-next.mjs",
    "build": "next build",
    "start": "next start",
    "test": "node --test src/domain/olist/core.test.mjs src/domain/catalog/marketplaceTitles.test.mjs src/domain/mercadoLivre/core.test.mjs src/domain/mercadoLivre/publishingCore.test.mjs src/domain/mercadoLivre/genericPublishingCore.test.mjs",
    "test:catalog": "node --test src/domain/catalog/marketplaceTitles.test.mjs",
    "test:olist": "node --test src/domain/olist/core.test.mjs",
    "test:mercado-livre": "node --test src/domain/mercadoLivre/core.test.mjs src/domain/mercadoLivre/publishingCore.test.mjs src/domain/mercadoLivre/genericPublishingCore.test.mjs",
    "mercado-livre:inspect": "node scripts/mercado-livre-inspect.mjs",
    "mercado-livre:validate-pilot": "node scripts/mercado-livre-validate-pilot.mjs",
    "mercado-livre:validate-generic": "node scripts/mercado-livre-validate-generic.mjs",
    "marketplace:audit-readiness": "node scripts/audit-marketplace-readiness.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck",
    "verify": "npm run check && npm run build",
    "diagnose": "node scripts/project-diagnose.mjs",
    "health": "npm run db:check && npm run catalog:audit",
    "lint": "next lint",
    "db:migrate": "node scripts/migrate-catalog-db.mjs",
    "db:check": "node scripts/check-catalog-db.mjs",
    "db:check-variants": "node scripts/check-variant-sync.mjs",
    "db:backfill-variants": "node scripts/backfill-asia-variants.mjs",
    "db:repair-asia": "node scripts/repair-asia-catalog.mjs",
    "olist:check-variants": "node scripts/check-olist-variant-eligibility.mjs",
    "olist:audit-images": "node scripts/audit-olist-images.mjs",
    "olist:audit-images:remote": "node scripts/audit-olist-images.mjs --remote --limit 5",
    "olist:configure-window": "node scripts/configure-olist-window.mjs",
    "olist:run-local-cron": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-local-olist-cron.ps1",
    "olist:recover-orphans": "node scripts/recover-olist-orphans.mjs",
    "olist:clear-lock": "node scripts/clear-olist-advisory-lock.mjs",
    "catalog:audit": "node scripts/audit-catalog-health.mjs",
    "catalog:normalize-titles": "node scripts/normalize-marketplace-titles.mjs --apply",
    "db:copy-to-production": "node scripts/copy-catalog-db.mjs",
    "admin:create-user": "node scripts/create-admin-user.mjs"
  },
  "dependencies": {
    "@types/pg": "^8.20.3",
    "lucide-react": "^0.468.0",
    "next": "^15.5.22",
    "pg": "^8.22.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "9.17.0",
    "eslint-config-next": "^15.5.22",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
