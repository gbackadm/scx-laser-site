# Copie para .env.local para desenvolvimento local.
# Nao coloque segredos reais neste arquivo versionado.

# Mantem o painel de catalogo em modo demonstrativo local.
# Em producao, use autenticacao real antes de habilitar qualquer painel.
ADMIN_DEMO_MODE=enabled

# Conexao PostgreSQL local. Preencha somente em .env.local ou no ambiente.
# DATABASE_URL=postgresql://usuario:senha@localhost:5433/scx_db
# Em Docker, se o PostgreSQL estiver no host, normalmente use host.docker.internal.
# DATABASE_URL=postgresql://usuario:senha@host.docker.internal:5433/scx_db

# Credenciais Asia Import. Preencha somente em .env.local ou no ambiente.
# ASIA_IMPORT_API_KEY=
# ASIA_IMPORT_SECRET_KEY=
# ASIA_IMPORT_BASE_URL=https://api.asiaimport.com.br/

# Credenciais Olist/Tiny ERP. Preencha somente em .env.local ou no ambiente.
# OLIST_API_TOKEN=
# OLIST_DEFAULT_ORIGIN=2
# OLIST_CRON_SECRET=
# ASIA_IMPORT_CRON_SECRET=

# AUTH_SECRET=
# AUTH_PROVIDER_CLIENT_ID=
# AUTH_PROVIDER_CLIENT_SECRET=
